  <div class="main-wrap
  {% if template.name == 'index' %}home-page{% endif %}
  {% if template.name == 'product' %}product-page{% endif %}
  {% if template.name == 'account' %}account-page{% endif %}
  {% if template.name == 'page' %}custom-page{% endif %}
  {% if template.name == 'login' %}forgot-page{% endif %}
  {% if template.name == 'register' %}forgot-page{% endif %}
  {% if page.template_suffix == 'my-subscriptions' %}order-history-page{% endif %}
  {% if page.template_suffix == 'store-locator' %}store-location-page{% endif %}
  {% if page.template_suffix == 'subscribe' %}subscription-page{% endif %}
  {% if page.template_suffix == 'about2' %}about-page{% endif %}
  {% if page.template_suffix == 'marquology' %}marquology-page{% endif %}
  {% if page.template_suffix == 'contact2' %}contact-us-page{% endif %}
  {% if page.template_suffix == 'faqs' %}faq-page{% endif %}
  {% if page.template_suffix == 'sponsorship' %}sponorship-page{% endif %}
  {% if page.template_suffix == 'wholesale' %}contact-us-wholesale-page{% endif %}
  {% if page.template_suffix == 'b2b-promotions' %}promotions-page{% endif %}
  {% if template.name == '404' %}page-404{% endif %}
  {% if page.template_suffix == 'lead-capture' %}lead-capture-page{% endif %}
  {% if page.template_suffix == 'press' %}press-page{% endif %}
">
    {% include 'login-form' %}
    {% section 'announcement-bar' %}
    {% section 'header' %}
      {% if request.path == '/challenge' %}
        {% include 'challenge' %}
      {% else %}
        {% liquid
          assign classes = 'page-wrap'
          if template == 'product'
            assign classes = classes | append: ' product-page-wrap'
          endif
          if template == 'product.merch'
            assign classes = classes | append: ' merchandise-pdp-page-wrap'
          endif
          if template == 'page.about2'
            assign classes = classes | append: ' about-page-wrap'
          endif
          if template contains 'subscribe'
            assign classes = classes | append: ' subscription-page-wrap'
          endif
        %}
        <div class="{{ classes }}" data-template="{{ template }}">
            {{ content_for_layout }}
        </div>
      {% endif %}
    {% section 'footer' %}
    <div class="modal__overlay"></div>
</div>

