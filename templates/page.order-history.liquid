{{ 'style-order-history.css' | asset_url | stylesheet_tag }}
{% if customer %}

    {{ 'date.min.js' | asset_url | script_tag }}
    <script>
        function calculateEstimation(deliveryDateStart){

            var fromDate = Date.parse(deliveryDateStart).addDays({{ settings.delivery_from }});

            if (fromDate.is().saturday() || fromDate.is().sunday()) {
                fromDate = fromDate.next().monday();
            }
            var toDate = Date.parse(deliveryDateStart).addDays({{ settings.delivery_to }});
            if (toDate.is().saturday() || toDate.is().sunday()) {
                toDate = toDate.next().monday();
            }
            document.write(fromDate.toString('MMM dd') + '-' + toDate.toString('dd'));
        }
    </script>

<div class="page-wrap order-history-page-wrap"> <!-- START PAGE WRAP -->
    <section class="account-info">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="breadcrumbs">
                        <ul>
                            <li class="link"><a href="/account">My Account</a></li>
                            <li>Order History</li>
                        </ul>
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <div class="navigation-wrap">
                        {% include "account-sidebar-menu", active_menu: 'order-history'  %}
                    </div>
                </div>
                <div class="col-md-9">
                    <div class="content-wrap">
                        <div class="content-block">
                            <div class="block-title">Order History</div>
                            <div class="orders-wrap">

                                {% if customer.orders.size != 0 %}

                                    {% for order in customer.orders %}
                                        <div class="order-item display-flex">
                                            <div class="column order-info">
                                                <div class="order">
                                                    <div class="top-row">
                                                        <div class="column date">Order Date: {{ order.created_at | date: "%b %d, %Y"  }}</div>
                                                        <div class="column total">Total: {{ order.total_price | money }}</div>
                                                    </div>
                                                    <div class="products">
                                                        {% for line_item in order.line_items %}
                                                            <div class="item">
                                                                <div class="product-info">
                                                                    <div class="image-wrap">
                                                                        <a href="{{ line_item.product.url }}" target="_blank">
                                                                            {{ line_item.image | img_url: '100x' | img_tag }}
                                                                        </a>
                                                                    </div>
                                                                    <div class="content">
                                                                        <div class="title"><a href="{{ line_item.product.url }}" target="_blank">{{ line_item.title }}</a></div>
                                                                        <div class="info size">{{ line_item.product.metafields.arena.pack_count }} Pack</div>
                                                                        <div class="info delivery">Quantity: {{ line_item.quantity }}</div>
                                                                    </div>
                                                                </div>
                                                                <div class="total-price">
                                                                    <span>{{ line_item.original_price |  money }}</span>
                                                                </div>
                                                            </div>
                                                        {% endfor %}
                                                    </div>
                                                </div>
                                            </div>
                                            <div class="column order-status">
                                                {% if order.fulfillment_status == 'fulfilled' %}

                                                    <div class="status">
                                                        Status: {{ order.fulfillment_status_label }}
                                                    </div>

                                                    {% for line in order.line_items %}
                                                        {{ line.fulfillment_service }}
                                                        {% if line.fulfillment.created_at %}
                                                            <div class="delivery">
                                                                <span>Shipped: {{ line.fulfillment.created_at | date: "%b %d, %Y" }}</span>
                                                                <span>Estimated delivery: <script>calculateEstimation('{{ line.fulfillment.created_at }}');</script></span>
                                                            </div>
                                                        {% endif %}
                                                        {% if line.fulfillment.tracking_url %}
                                                            <div class="delivery">
                                                                <a target="_blank" href="{{ line.fulfillment.tracking_url }}">Track Order</a>
                                                            </div>
                                                        {% endif %}
                                                    {% endfor %}

                                                {% else %}
                                                    <div class="status">
                                                        Status: {{ order.fulfillment_status_label }}
                                                    </div>
                                                    <div class="order-number">
                                                        Order Number: {{ order.order_number | link_to: order.customer_url }}
                                                    </div>
                                                {% endif %}

                                                <div class="links">
                                                    <div class="link"><a href="/pages/contact-us">Need help with your order?</a></div>
                                                </div>
                                            </div>
                                        </div>

                                    {% endfor %}

                                {% else %}

                                    <p>You have no orders yet!</p>

                                {% endif %}


                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div> <!-- END PAGE WRAP -->
{% else %}
<script>
    document.location.href='/';
</script>
{% endif %}