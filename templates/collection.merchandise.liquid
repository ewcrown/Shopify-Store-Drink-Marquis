{{ 'style-merch-main.css' | asset_url | stylesheet_tag }}
<div class="page-wrap merchandise-page-wrap"> <!-- START PAGE WRAP -->
    <section class="page-hero">
        <div class="container">
            <div class="row">
                <div class="col-md-12">
                    <div class="page-hero-wrap" style="background: linear-gradient(0deg, rgba(40, 71, 52, 0.64), rgba(40, 71, 52, 0.64)), url({{ collection.image | img_url: "master" }}), #C4C4C4;">
                        <h1 class="section-title">{{ collection.title }}</h1>
                        <div class="sub-title">#WEARTHECROWN</div>
                    </div>
                </div>
            </div>
        </div>
    </section>
    <section class="products">
        <div class="container">
            <div class="row">
                {% paginate collection.products by 1000 %}
                    {% assign counter = 1 %}
                    {% for product in collection.products %}

                        {% include "merchandise-product-grid", counter:counter %}

                        {% if counter == 3 %}
                            {% assign counter = 1 %}
                        {% else %}
                            {% assign counter = counter | plus:1 %}
                        {% endif %}
                    {% endfor %}
                {% endpaginate %}
            </div>
        </div>
    </section>
</div> <!-- END PAGE WRAP -->
