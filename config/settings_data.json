      "faq-template": {
        "type": "faq-template",
        "blocks": {
          "59e9ed04-8fef-475e-8202-5dc1ce499aba": {
            "type": "question",
            "settings": {
              "title": "Can I really cancel at any time?",
              "answer": "Of course! We want you to be happy with your order. In your Account dashboard, you’re able to edit your order frequency, flavor, and quantity. If you’re sure you want to cancel, you can do so in your Account dashboard as well. No hard feelings!",
              "faq-section": "subscriptions"
            }
          },
          "5f4220e9-6a58-4d74-809c-f386538955c6": {
            "type": "question",
            "settings": {
              "title": "Do I have to pay for return orders?",
              "answer": "All Sale items are final and may not be returned, refunded, or exchanged unless they were defective or damaged.",
              "faq-section": "returns"
            }
          },
          "de16089c-2df5-42f5-bc6a-4e1b0a55d29e": {
            "type": "question",
            "settings": {
              "title": "How can I edit my subscription?",
              "answer": "Please create a login account where you'll be able to make edits to your subscriptions.",
              "faq-section": "subscriptions"
            }
          },
          "ccea8c65-60d8-4b66-b423-baeadb4501fb": {
            "type": "question",
            "settings": {
              "title": "What are the benefits of multi-case orders?",
              "answer": "When you add 2 cases of Marquis you'll receive free shipping and if you add another case you'll receive 10% on top of your order.",
              "faq-section": "wholesale"
            }
          },
          "f754519a-18a0-4a93-98da-3c7badf8c09f": {
            "type": "question",
            "settings": {
              "title": "What if I don’t like the flavor I choose?",
              "answer": "Exchanges are accepted within 14 days of receiving your order. The customer pays for return postage.",
              "faq-section": "subscriptions"
            }
          },
          "c823e454-75ca-4953-9734-c5966b154e48": {
            "type": "question",
            "settings": {
              "title": "What is Marquis’ unique blend of caffeine made of?",
              "answer": "Marquis caffeine blend is naturally derived from three plant-based ingredients: Yerba Mate, Green Coffee, and Green Tea.",
              "faq-section": "product-use"
            }
          },
          "d3e756ae-2afe-4106-873a-e7ed0e5c4eb4": {
            "type": "question",
            "settings": {
              "title": "How much caffeine is in Marquis?",
              "answer": "Each can of Marquis contains 100 milligrams of plant-based organic caffeine.",
              "faq-section": "product-use"
            }
          },
          "3870c818-eb3d-4f88-aee6-f4846c5b15c6": {
            "type": "question",
            "settings": {
              "title": "If Marquis is sugar free, then how is it sweet?",
              "answer": "Stevia, which is a plant that doesn’t contain calories. We use a very high quality strain of stevia extract called Rebiana A 98%.",
              "faq-section": "product-use"
            }
          },
          "b9a236b3-aced-4d02-866c-caf2a6dcd863": {
            "type": "question",
            "settings": {
              "title": "Is there alcohol in Marquis?",
              "answer": "No, that’s for you to add.",
              "faq-section": "all"
            }
          },
          "be32733d-1b7a-40f4-b4ce-669e446cd673": {
            "type": "question",
            "settings": {
              "title": "Why are there carbs listed on the nutrition label in Marquis, but you say it’s carb free?",
              "answer": "The carbs provided by the erythritol are not absorbed by the body; therefore, Marquis is zero net carbs.",
              "faq-section": "all"
            }
          },
          "42ca2aa0-fe6d-4313-8725-f0114d6fa955": {
            "type": "question",
            "settings": {
              "title": "What is Erythritol?",
              "answer": "Erythritol is a natural sweetener commonly used with Stevia. It is made from USDA Organic, Non-GMO corn. (er-rith-re-tal) is a naturally occurring sugar alcohol, produced commercially by fermentation of a carbohydrate substrate. Our erythritol is certified USDA Organic, Non-GMO Project Verified, Calorie-Free, and registers Zero on the Glycemic Index.",
              "faq-section": "all"
            }
          },
          "4ccd19a9-9e38-4b42-9305-38f612485bfa": {
            "type": "question",
            "settings": {
              "title": "What is Reverse Osmosis?",
              "answer": "This water purification method uses a semipermeable membrane which filters out contaminants and other harmful compounds such as lead, arsenic and nitrates.",
              "faq-section": "all"
            }
          },
          "4abd7d50-6076-4751-8c6a-064883148454": {
            "type": "question",
            "settings": {
              "title": "Does Marquis have vitamins?",
              "answer": "Yes, Marquis contains your daily dose of Vitamin C and 4 types of B vitamins.",
              "faq-section": "all"
            }
          },
          "d21efac7-23c7-4cd1-9c15-6d0e91e9447d": {
            "type": "question",
            "settings": {
              "title": "Where do the antioxidants in Marquis come from?",
              "answer": "Marquis is packed with antioxidants that all come from our one-of-a-kind blend of Yerba Mate, Green Coffee, and Green Tea.",
              "faq-section": "all"
            }
          },
          "ae6a72d5-aceb-4a54-b6ec-9c678fbf7f56": {
            "type": "question",
            "settings": {
              "title": "Is Marquis certified USDA Organic?",
              "answer": "Yes, and nothing can change our mind.",
              "faq-section": "all"
            }
          },
          "752c8d88-0f7e-4f48-817c-820d8b66e8a8": {
            "type": "question",
            "settings": {
              "title": "Is Marquis safe for vegans and vegetarians?",
              "answer": "Yes, Marquis is certified vegan and vegetarian!",
              "faq-section": "all"
            }
          },
          "e806e736-4e62-410f-be61-325560e34f3d": {
            "type": "question",
            "settings": {
              "title": "Do I have to pay for shipping?",
              "answer": "If you add 2 or more cases of Marquis you'll receive Free Shipping.",
              "faq-section": "shipping-deliveries"
            }
          },
          "4bd09874-e792-4be8-89fd-13212cd74b4b": {
            "type": "question",
            "settings": {
              "title": "How long will it take to receive my order?",
              "answer": "Orders typically take up to 24 hours to process, and shipping typically takes 3-7 days.",
              "faq-section": "shipping-deliveries"
            }
          }
        },
