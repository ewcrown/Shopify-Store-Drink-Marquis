      "faq-short-list": {
        "type": "faq-short-list",
        "blocks": {
          "cac3d9e0-7d40-4823-a818-6a4ef3c31b87": {
            "type": "question",
            "settings": {
              "title": "How is Marquis sugar-free?",
              "answer": "<p>Refined sugar is a relatively new addition to our diets. And it’s not a good one. So, we don’t use it. Instead, we sweeten our drinks with monk fruit. </p>"
            }
          },
          "e64c55e0-4329-4bdd-bab3-260797f8cf5e": {
            "type": "question",
            "settings": {
              "title": "Why did we make Marquis?",
              "answer": "<p>Before we started Marquis, our routine was riddled with drip coffee and energy drinks. Over time, we found that this toxic mix of large amounts of sugar and low quality caffeine was wreaking havoc on our minds and bodies. So, we designed our own clean, vitamin-rich caffeine beverage carefully calibrated for the perfect lift.</p>"
            }
          },
          "a3ca74e6-480b-40ac-b7d5-5da34f5452af": {
            "type": "question",
            "settings": {
              "title": "What is Marquis’ unique caffeine blend made of?",
              "answer": "<p>Organic & unprocessed plants; specifically Yerba Mate leaves, Green Coffee beans, and Green Tea.</p>"
            }
          },
          "293d8387-89ed-4aa5-b787-ad40bfd376b1": {
            "type": "question",
            "settings": {
              "title": "How much caffeine is in Marquis?",
              "answer": "<p>Each can contains exactly 100mg of plant-based organic caffeine. At this quality, that’s just the right amount to elevate your energy levels without risking any jitters or crashing.</p>"
            }
          },
          "c2d5714a-f125-46c5-aa61-f1e84df9a207": {
            "type": "question",
            "settings": {
              "title": "What is Marquis flavored with?",
              "answer": "<p>Real fruit. No chemicals, artificial flavors or sweeteners. Just good old fashioned plants.</p>"
            }
          },
          "374dd389-6511-4975-8ba1-5b0ed5fd9c9d": {
            "type": "question",
            "settings": {
              "title": "Is  Marquis gluten-free, vegetarian, vegan and kosher?",
              "answer": "<p>Yes, yes, yes and yes again. Plant power for all!</p>"
            }
          },
          "06106a15-255f-4e6f-ad9c-ef3350197429": {
            "type": "question",
            "settings": {
              "title": "Does the drink contain GMOs?",
              "answer": "<p>No, and they never will! We believe we should be eating and drinking from organic farms, not test tubes.</p>"
            }
          }
        },
