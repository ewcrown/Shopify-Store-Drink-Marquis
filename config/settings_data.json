      "subscribe-faq": {
        "type": "subscribe-faq",
        "blocks": {
          "525c4020-105d-423c-8dfc-48407cfb47a1": {
            "type": "question",
            "settings": {
              "title": "Can I really cancel at any time?",
              "answer": "<p>Of course! We want you to be happy with your order. In your Account dashboard, you’re able to edit your order frequency, flavor, and quantity. If you’re sure you want to cancel, you can do so in your Account dashboard as well. No hard feelings!</p>"
            }
          },
          "5905097f-eaa9-48a3-8430-0e2deea9ae52": {
            "type": "question",
            "settings": {
              "title": "Do I have to pay for shipping?",
              "answer": "<p>If you add 2 or more cases of Marquis you'll receive Free Shipping.</p>"
            }
          },
          "6c208542-cf7e-4d40-bbf1-d56812f87aa9": {
            "type": "question",
            "settings": {
              "title": "What if I don’t like the flavor I choose?",
              "answer": "<p>Please login into your account where you'll be able to make edits to your subscriptions.</p>"
            }
          },
          "bbb06a94-faa6-40f8-af05-cf897340508e": {
            "type": "question",
            "settings": {
              "title": "What are the benefits of multi-case orders?",
              "answer": "<p>When you add 2 cases of Marquis you'll receive free shipping and if you add another case you'll receive 10% on top of your order.</p>"
            }
          },
          "8505664b-3e0a-41be-b97f-9186ac7b9ec0": {
            "type": "question",
            "settings": {
              "title": "How can I edit my subscription?",
              "answer": "<p>Please login into your account where you'll be able to make edits to your subscriptions.</p>"
            }
          }
        },
