{%- form 'product', product, data-productid: product.id, class: form_class, data-section: section_id -%}
    {% if merchandise != 1 %}
        <div class="variant-columns">
            <div class="column left-column">
                {% if product.metafields.arena.pack_count != blank %}
                    <div class="size">{{ product.metafields.arena.pack_count }}-Pack</div>
                    <input type="hidden" class="product_extra_properties" value="{{ product.metafields.arena.pack_count }} Pack"/>
                    <div class="price price-custom"   id="price_normal_{{ product.id }}"  style="display: none">
                  {% assign price_per_item = product.price | divided_by: product.metafields.arena.pack_count %}
                        {{ product.price | money }}/can 
                    </div>
                    <div class="subscribe-save">Subscribe & Save</div>
                {% endif %}
            </div>
            <div class="column right-column">
                {% if product.available %}
                    {% comment %}
                        Subscription Section
                    {% endcomment %}
                    {% comment %} BOLD if product.selling_plan_groups.size > 0 {% endcomment %}
                    {% if product.metafields.subscriptions.shipping_interval_frequency %}
                        <div class="loadingSubscribeOptions" id="loadingSubscribeOptions_{{ product.id }}">Loading...</div>
                        <div class="sudscibe-options" style="display: none">
                            {% comment %} BOLD {% include 'bsub-widget-custom' %}{% endcomment %}
                            <input type="hidden" id="current_product_id" value="{{ product.id }}" />
                            <input type="hidden" id="current_product_selling_plan" value="{{ product.selling_plan_groups[0].selling_plans[0].id }}" />

                            {% include 'subscription-product' %}
                        </div>

                    {% else %}
                        {% if product.available %}
                            <div class="sudscibe-options">
                                <div class="field-wrap active">
                                    <label for="rad-1" class="name"><span>{{ product.price | money }}</span></label>
                                </div>
                            </div>
                        {% else %}
                            <div class="sudscibe-options">
                                <div class="field-wrap active">
                                    <label for="rad-1" class="name"><span>Sold Out</span></label>
                                </div>
                            </div>
                        {% endif %}
                    {% endif %}
                {% endif %}
            </div>
        </div>
    {% endif %}
<div class="buttons-wrap" style="{% if merchandise != 1 %}display: none{% endif %}" id="buttons-wrap_{{ product.id }}">
    {% if product.available %}

        {% assign product_quantity   = product.selected_or_first_available_variant.inventory_quantity %}
        {% assign product_variand_id = product.selected_or_first_available_variant.id %}

        {% if product.selected_or_first_available_variant.inventory_management == 'shopify' and product_quantity > 0 %}
            <input type="hidden" id="product_max_quantity" value="{{ product_quantity }}"/>
        {% else %}
            <input type="hidden" id="product_max_quantity_{{ product.id }}" value="1000"/>
        {% endif %}

        <input type="hidden" class="product_min_quantity" id="product_min_quantity_{{ product.id }}" value="1"/>
        <input type="hidden" id="selected_or_first_available_variant_{{ product.id }}" name="id" value="{{ product_variand_id }}"/>
        <input type="hidden" id="subscribe_variant_id_{{ product.id }}"  value="{{ product.selected_or_first_available_variant.metafields.subscriptions.discount_variant_id }}" />

        <div class="quantity-wrap">
            <span data-product_id="{{ product.id }}" class="minus button-quantity-change icon-minus"></span>
            <input class="input product_selected_quantity" type="text" id="product_selected_quantity_{{ product.id }}"  value="1" />
            <span data-product_id="{{ product.id }}" class="plus button-quantity-change icon-plus"></span>
        </div>

        <div class="btn-wrap add-to-cart">
            {% comment %}
            {% if product.selling_plan_groups.size > 0 %}
                <a class="btn-link btn-bg-orange btn-add-to-cart" href="javascript:void(0);" onclick="addSubscribeItemToCart({{ product_variand_id }}, {% if multiproducts == 1 %}{{ product.id }}{% else %}0{% endif %});">Add to Cart</a>
            {% else %}
                <a class="btn-link btn-bg-orange btn-add-to-cart" href="javascript:void(0);" onclick="addItemToCart();">Add to Cart</a>
            {% endif %}
            {% endcomment %}

            <a class="btn-link btn-bg-orange btn-add-to-cart" href="javascript:void(0);" onclick="addItemToCartRecharge({{ product.id }});">Add to Cart</a>

        </div>
    {% else %}

        <div class="quantity-wrap">
            <span data-product_id="{{ product.id }}" class="minus button-quantity-change icon-minus"></span>
            <input disabled class="input product_selected_quantity" type="text" id="product_selected_quantity_{{ product.id }}"  value="1" />
            <span data-product_id="{{ product.id }}" class="plus button-quantity-change icon-plus"></span>
        </div>

        <div class="btn-wrap add-to-cart">
            <a class="btn-link btn-bg-orange btn-add-to-cart sold-out" href="javascript:void(0);">Sold Out</a>
        </div>
    {% endif %}
</div>
{% endform %}

