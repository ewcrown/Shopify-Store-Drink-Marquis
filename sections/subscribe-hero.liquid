{{ 'style-subscription.css' | asset_url | stylesheet_tag }}

<style>
    .subscription-page-wrap{
        background: linear-gradient(180deg, {{ section.settings.first-color }} 17.87%, {{ section.settings.second-color }} 35.22%, #FFFCEB 56.16%);
    }
    .subscription-page-wrap section.subscride-options::before {
        background: linear-gradient(180deg,{{ section.settings.first-color }} 0,{{ section.settings.first-color }} 52.6%, rgba(216,231,224,0) 100%);
    }
    .one-time-subscribe-block{
        display: none !important;
    }
  .subscription-page-wrap section.head .container .hero-content .description{
    font-size: 1.5rem;
    line-height: 1.2;
    text-align: center;
  }
  .hero-overlay{
    position: absolute;
    z-index: -1;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: rgb(0 0 0 / 29%);
  }
  .subscription-page-wrap section.head .hero-content h1{
    text-align: center;
  }
  .subscription-page-wrap section.head .hero-content div.btn-link{
    width: 100%;
  }
  .subscription-page-wrap section.head .hero-content .btn-link a{
    margin-left: auto;
    margin-right: auto;
  }
</style>

<section class="head" style="background-image: url({{ section.settings.hero-bg | img_url: 'master'}});">
    <div class="hero-overlay"></div>
    <div class="container">
        <div class="row">
            <div class="col-12">
                <div class="hero-content">
                    <h1 class="hero-title">{{ section.settings.page-title }}</h1>
                    <div class="description">{{ section.settings.page-sub-title }}</div>
                    <div class="btn-link"><a href="javascript:void(0)"class="scroll_to_subscribe btn-link btn-bg-green btn-shop">{{ section.settings.btn_text }}</a></div>
                </div>
            </div>
        </div>
    </div>
</section>

{% if section.settings.cta_bg_color != blank %}
    <style>
      .subscription-page-wrap .btn-link{
        background-color:{{ section.settings.cta_bg_color }} !important;
        color:{{ section.settings.cta_text_color }} !important;
      }
    </style>
{% endif %}

{% schema %}

{
    "name": "Page hero",
    "settings": [
        {
            "type": "image_picker",
            "id": "hero-bg",
            "label": "Hero background"
        },
        {
            "type": "text",
            "id": "page-title",
            "label": "Page title"
        },
        {
            "type": "text",
            "id": "page-sub-title",
            "label": "Page sub title"
        },
        {
            "type": "text",
            "id": "btn_text",
            "label": "Button Title"
        },
        {
          "type": "color",
          "id": "cta_bg_color",
          "label": "CTA BG Color"
        },
        {
          "type": "color",
          "id": "cta_text_color",
          "label": "CTA TEXT Color"
        },
        {
            "type": "color",
            "id": "first-color",
            "label": "First gradient color",
            "default": "#FF9F5C"
        },
        {
            "type": "color",
            "id": "second-color",
            "label": "Second gradient color",
            "default": "#FFD79A"
        }
    ]
}

{% endschema %}
