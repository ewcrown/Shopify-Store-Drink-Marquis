    <button class="ew-close">&times;</button>

    {% if product.metafields.custom.product_details_image != blank %}
      <img id="ew-modalImage" 
           src="{{ product.metafields.custom.product_details_image | img_url: 'master' }}" 
           alt="Product Details" 
           width="600" 
           height="600" />
    {% else %}
      <p style="color:white; text-align:center;">Nothing available....</p>
    {% endif %}
  </div>
</div>

<!-- Script -->
<script>
  document.addEventListener("DOMContentLoaded", function () {
    const modal = document.getElementById('ew-productModal');
    const openBtn = document.querySelector('.ew-product-details-popup');
    const closeBtn = modal.querySelector('.ew-close');

    if (openBtn && modal && closeBtn) {
      openBtn.addEventListener('click', function () {
        modal.style.display = 'flex'; // flex for centering
      });

      closeBtn.addEventListener('click', function () {
        modal.style.display = 'none';
      });

      window.addEventListener('click', function (event) {
        if (event.target === modal) {
          modal.style.display = 'none';
        }
      });
    }
  });
</script>

{% schema %}
{
    "name": "Product Template",
    "settings": [
        {
            "type": "textarea",
            "id": "shipping_box_1",
            "label": "Shipping Box 1",
            "default": "<p>Order <span>2 Cases:</span></p><p>Get Free Shipping</p>"
        },
        {
            "type": "textarea",
            "id": "shipping_box_2",
            "label": "Shipping Box 2",
            "default": "<p>Order <span>3 Cases:</span></p><p>Get Free Shipping + 10% Off</p>"
        },
        {
          "type": "color",
          "id": "cta_bg_color",
          "label": "CTA BG Color"
        }
    ],
    "blocks" : [
        {
            "name": "Product",
            "type": "product",
            "settings":[
                {
                    "type": "product",
                    "id": "product",
                    "label": "Product"
                }
            ]
        }
    ]
}
{% endschema %}
