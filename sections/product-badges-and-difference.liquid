<section class="gradient-section" id="badges">
    <div class="canvas-wrap" data-bubble-img="{{ "img_figma.png" | asset_url }}"></div>
    {% if product.metafields.arena.badge_image != blank %}
        <div class="sub-section-details">
            <div class="container">
                <div class="row">
                    <div class="col-12">
                        <div class="details-wrap display-flex">
                            {% assign counter = 0 %}
                            {% for badge in  product.metafields.arena.badge_image %}
                                <div class="detail-item">
                                    <div class="image-wrap">
                                        <img src="{{ badge }}" alt="{{ product.metafields.arena.badge_title[counter] | escape }}" />
                                    </div>
                                    <div class="description">{{ product.metafields.arena.badge_title[counter] }}</div>
                                </div>
                                {% assign counter = counter | plus:1 %}
                            {% endfor %}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    {% if product.metafields.arena.difference_image != blank %}
    <div class="sub-section-differences">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <div class="sub-section-title">{% if product.metafields.arena.difference_title != blank %}{{ product.metafields.arena.difference_title }}{% else %}What’s the difference?{% endif %}</div>
                    <div class="image-wrap">
                        <img src="{{ product.metafields.arena.difference_image }}" alt="Whats the difference" />
                    </div>
                </div>
            </div>
        </div>
    </div>
    {% endif %}

    {% comment %} {% if product.metafields.arena.why_we_made_image_1 != blank and product.metafields.arena.why_we_made_image_2 != blank %}
    <div class="sub-section-why-we-made">
        <div class="sub-container display-flex">
            <div class="column left-column">
                <div class="content-wrap">
                    <div class="sub-section-title">{% if product.metafields.arena.why_we_made_title != blank %}{{ product.metafields.arena.why_we_made_title }}{% else %}WHY WE MADE MARQUIS{% endif %}</div>
                    <div class="content">
                        {{product.metafields.arena.why_we_made_description}}
                    </div>
                </div>
            </div>
            <div class="column center-column">
                <div class="image-wrap">
                    <img src="{{ product.metafields.arena.why_we_made_image_1 }}" alt="WHY WE MADE MARQUIS" />
                </div>
            </div>
            <div class="column right-column">
                <div class="image-wrap">
                    <img src="{{ product.metafields.arena.why_we_made_image_2 }}" alt="WHY WE MADE MARQUIS" />
                </div>
            </div>
        </div>
    </div>
    {% endif %} {% endcomment %}
</section>
<style>
    .canvas-wrap {
        position: fixed;
        z-index: 0;
        top: 0px;
        width: 100%;
        height: 100%;
    }
    .canvas-wrap canvas {
        width: 100%;
    }
</style>
