<footer>
    {% if template.name == 'index' or template.name == 'product' %}

    {% endif %}
    <div class="walve-footer"></div>
    <div class="container custom-container">
        <div class="row">
            <div class="col-md-7 mobile-order-2">
                <div class="row">
                    <div class="col-md-6 mobile-order-2">
                        <a class="link-txt light-green desktop-view" href="/">{{ section.settings.footer_title }}</a>
                        <div class="images-wrap">
                            <div class="images-wrap certification-wrap">
                                {% for block in section.blocks %}
                                    <div class="image-wrap">
                                        <a target="_blank" href="{% if block.settings.logo_url != blank %}{{ block.settings.logo_url }}{% else %}javascript:void(0){% endif %}"><img src="{{ block.settings.logo | img_url: "master" }}" /></a>
                                    </div>
                                {% endfor %}
                                <!--
                                <div class="image-wrap">
                                    <a href="#"><img src="../assets/Certification-1.png" alt=""></a>
                                </div>
                                <div class="image-wrap">
                                    <a href="#"><img src="../assets/Certification-2.png" alt=""></a>
                                </div>
                                <div class="image-wrap">
                                    <a href="#"><img src="../assets/Certification-3.png" alt=""></a>
                                </div>
                                <div class="image-wrap">
                                    <a href="#"><img src="../assets/Certification-4.png" alt=""></a>
                                </div>
                                <div class="image-wrap">
                                    <a href="#"><img src="../assets/Certification-5.png" alt=""></a>
                                </div>
                                <div class="image-wrap">
                                    <a href="#"><img src="../assets/Certification-6.png" alt=""></a>
                                </div>
                                -->
                            </div>
                            <!-- <div class="image-wrap">
                                <img src="{{ "footer_img2.png" | asset_url }}" />
                            </div> -->
                        </div>
                    </div>
                    <div class="col-md-6 mobile-order-1">
                        <div class="nav-wrap display-flex">
                            <ul class="nav-list">
                                {% for link in linklists.new-footer-block-1.links %}
                                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                                {% endfor %}
                                {% if customer %}
                                    <li><a href="/account">Account</a></li>
                                {% endif %}
                            </ul>
                            <ul class="nav-list">
                                {% for link in linklists.new-footer-block-2.links %}
                                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                                {% endfor %}
                            </ul>
                            <ul class="nav-list">
                                {% for link in linklists.new-footer-block-3.links %}
                                    <li><a href="{{ link.url }}">{{ link.title }}</a></li>
                                {% endfor %}
                            </ul>
                        </div>
                    </div>
                </div>
            </div>
            <div class="col-md-5 mobile-order-1">
                <a class="link-txt light-green mobile-view" href="/">Not All Caffeine Is Created Equal</a>
                <div class="form-wrap">
                    {% include "subscribe-form" %}
                </div>
                <ul class="social-link display-flex">
                    {% if settings.fb_link %}<li><a target="_blank" href="{{ settings.fb_link }}"><img src="{{ "f-icon.svg" | asset_url }}"></a></li>{% endif %}
                    {% if settings.ig_link %}<li><a target="_blank" href="{{ settings.ig_link }}"><img src="{{ "i-icon.svg" | asset_url }}"></a></li>{% endif %}
                    {% if settings.linkedin_link %}<li><a target="_blank" href="{{ settings.linkedin_link }}"><img src="{{ "l-icon.svg" | asset_url }}"></a></li>{% endif %}
                    {% if settings.pint_link %}<li><a target="_blank" href="{{ settings.pint_link }}"><img src="{{ "p-icon.svg" | asset_url }}"></a></li>{% endif %}
                    {% if settings.tiktok_link %}<li><a target="_blank" href="{{ settings.tiktok_link }}"><img src="{{ "i-tt.png" | asset_url }}"></a></li>{% endif %}
                    {% if settings.spotify_link %}<li><a target="_blank" href="{{ settings.spotify_link }}"><img src="{{ "n-sptf2x.png" | asset_url }}"></a></li>{% endif %}
                </ul>
            </div>
        </div>
        <div class="row">
            <div class="col-12">
                <div class="copyright">
                    <span>{{ settings.copyright_text }}</span>
                    <a class="copyright-link" href="/pages/privacy-policy">Legal</a>
                    <a class="copyright-link" href="/pages/privacy-policy">Privacy Policy</a>
                </div>
            </div>
        </div>
    </div>
</footer> <!-- END FOOTER -->

{% schema %}
    {
    "name": "Footer",
    "settings": [
        {
            "type": "text",
            "id": "footer_title",
            "label": "Footer Title",
            "default": "Not All Caffeine Is Created Equal"
        }
    ],
    "blocks": [
        {
            "type": "certification_logo",
            "name": "Certification Logo",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "logo",
                    "label": "Logo"
                },
                {
                    "type": "url",
                    "id": "logo_url",
                    "label": "Logo Url"
                }
            ]
        }
    ]
    }
{% endschema %}
