<section class="content">
    <div class="container">
        <div class="row">
            <div class="col-12">
                <h1 class="section-title">{{ section.settings.title }}</h1>
                <div class="sub-title">{{ section.settings.description }}</div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-12">
                <div class="contact-wrap">
                    <div class="form-wrap">
                       <div style="margin:0 auto;" class="pxFormGenerator" id="mMSbqbjjOAxwMDVwK7Quxg"></div>
                    </div>


                    {% comment %}
                    <form action="">
                        <div class="input-field">
                            <input type="text" placeholder="Name of Requester*">
                        </div>
                        <div class="display-flex">
                            <div class="input-field">
                                <input type="text" placeholder="Date Requested*">
                            </div>
                            <div class="input-field">
                                <input type="text" placeholder="Date Needed*">
                            </div>
                        </div>
                        <div class="display-flex">
                            <div class="input-field">
                                <div class="select-field">
                                    <span class="current">Location Type*</span>
                                    <ul class="select-options">
                                        <li>USA</li>
                                        <li>Canada</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="input-field">
                                <div class="select-field">
                                    <span class="current">Activation Type*</span>
                                    <ul class="select-options">
                                        <li>USA</li>
                                        <li>Canada</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                        <div class="input-field">
                            <div class="select-field">
                                <span class="current">POS Type*</span>
                                <ul class="select-options">
                                    <li>USA</li>
                                    <li>Canada</li>
                                </ul>
                            </div>
                        </div>
                        <div class="input-field">
                            <input type="text" placeholder="Promotion Name*">
                        </div>
                        <div class="input-field">
                            <input type="text" placeholder="Content Idea*">
                        </div>
                        <div class="input-field file-input">
                            <span class="top">Inspiration Document Attachment*</span>
                            <span class="bottom">[File Attachment: PNG/PDF]</span>
                        </div>
                        <div class="additional-reques">
                            <div class="title">Additional Marketing Request</div>
                            <div class="options-wrap">
                                <div class="sub-title">Swag Item(s) Request</div>
                                <div class="display-flex">
                                    <div class="column">
                                        <div class="input-checkbox">
                                            <label for="additional-1">Chapstick</label>
                                            <input id="additional-1" type="checkbox">
                                            <span class="custom-checkbox"></span>
                                        </div>
                                        <div class="input-checkbox">
                                            <label for="additional-2">Slim Koozie</label>
                                            <input id="additional-2" type="checkbox">
                                            <span class="custom-checkbox"></span>
                                        </div>
                                        <div class="input-checkbox">
                                            <label for="additional-3">Promo Hats</label>
                                            <input id="additional-3" type="checkbox">
                                            <span class="custom-checkbox"></span>
                                        </div>
                                    </div>
                                    <div class="column">
                                        <div class="input-checkbox">
                                            <label for="additional-4">Promo T-Shirts</label>
                                            <input id="additional-4" type="checkbox">
                                            <span class="custom-checkbox"></span>
                                        </div>
                                        <div class="input-checkbox">
                                            <label for="additional-5">Stickers</label>
                                            <input id="additional-5" type="checkbox">
                                            <span class="custom-checkbox"></span>
                                        </div>
                                        <div class="input-checkbox">
                                            <label for="additional-6">Tote Bags</label>
                                            <input id="additional-6" type="checkbox">
                                            <span class="custom-checkbox"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="options-wrap">
                                <div class="sub-title">Demo Activation Request</div>
                                <div class="display-flex">
                                    <div class="column">
                                        <div class="input-checkbox">
                                            <label for="additional-7">Table Cloth</label>
                                            <input id="additional-7" type="checkbox">
                                            <span class="custom-checkbox"></span>
                                        </div>
                                        <div class="input-checkbox">
                                            <label for="additional-8">Retractable Banner</label>
                                            <input id="additional-8" type="checkbox">
                                            <span class="custom-checkbox"></span>
                                        </div>
                                        <div class="input-checkbox">
                                            <label for="additional-9">eCommerce Coupons</label>
                                            <input id="additional-9" type="checkbox">
                                            <span class="custom-checkbox"></span>
                                        </div>
                                    </div>
                                    <div class="column">
                                        <div class="input-checkbox">
                                            <label for="additional-10">EZ Up</label>
                                            <input id="additional-10" type="checkbox">
                                            <span class="custom-checkbox"></span>
                                        </div>
                                        <div class="input-checkbox">
                                            <label for="additional-11">Barrel Cooler</label>
                                            <input id="additional-11" type="checkbox">
                                            <span class="custom-checkbox"></span>
                                        </div>
                                        <div class="input-checkbox">
                                            <label for="additional-12">On-Premise Sale Sheet</label>
                                            <input id="additional-12" type="checkbox">
                                            <span class="custom-checkbox"></span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <div class="input-field submit-input">
                            <input type="submit" value="Submit">
                        </div>
                    </form>

                    {% endcomment %}
                    <div class="success-msg" style="display: none;">
                        <p>Your request has been sent successfully.</p>
                        <p><a href="#">Back to Promotions Request</a></p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{% schema %}

{
    "name": "Page hero",
    "settings": [
        {
            "type": "text",
            "id": "title",
            "label": "Title"
        },
        {
            "type": "textarea",
            "id": "description",
            "label": "Description"
        }
    ]
}

{% endschema %}
