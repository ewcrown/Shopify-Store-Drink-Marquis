{{ 'style-press.css' | asset_url | stylesheet_tag }}

<div class="page-wrap press-page-wrap press2"> <!-- START PAGE WRAP -->
    <section class="content">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h1 class="section-title">{{ section.settings.title }}</h1>
                    <div class="sub-title">{{ section.settings.sub-title }}</div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="press-grid">
                        {% for block in section.blocks %}
                        <div class="press-item-warp">
                            <div class="press-item">
                                <div class="image-wrap image-{{ block.settings.image-targ }}" style="background-color: {{ block.settings.bg-color }};">
                                      <a href="{{ block.settings.link }}"><img src="{{ block.settings.image_preview | img_url: '2000x' }}" alt=""></a>
                                </div>
                                <div class="source-wrap">{{ block.settings.title }}</div>
                                <div class="content-wrap">{{ block.settings.content }}</div>
                                <div class="link">
                                    <a href="{{ block.settings.link }}" target="_blank">Read More</a>
                                </div>
                            </div>
                        </div>

                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    </section>
</div> <!-- END PAGE WRAP -->

{% schema %}

{
    "name": "Page header",
    "settings": [
        {
            "type": "text",
            "id": "title",
            "label": "Title"
        },
        {
            "type": "text",
            "id": "sub-title",
            "label": "Sub title"
        }
    ],
    "blocks": [
        {
            "name": "Press",
            "type": "press",
            "settings": [
                {
                    "type": "image_picker",
                    "id": "image_preview",
                    "label": "Image preview"
                },
                {
                    "type": "select",
                    "id": "image-targ",
                    "label": "Image Type",
                    "options": [
                      {
                        "value": "logo",
                        "label": "Logo"
                      },
                      {
                        "value": "background",
                        "label": "Background"
                      }
                    ],
                    "default": "logo"
                },
                {
                    "type": "color",
                    "id": "bg-color",
                    "label": "Background Color"
                },
                {
                    "type": "text",
                    "id": "title",
                    "label": "Source Brand"
                },
                {
                    "type": "textarea",
                    "id": "content",
                    "label": "Content"
                },
                {
                    "type": "url",
                    "id": "link",
                    "label": "Link"
                }
            ]
        }
    ]
}

{% endschema %}
