<div class="page-wrap lead-capture-page-wrap"> <!-- START PAGE WRAP -->
    <section class="content">
        <div class="container">
            <div class="row">
                <div class="col-12">
                    <h1 class="section-title">{{ section.settings.title }}</h1>
                    <div class="sub-title">{{ section.settings.sub-title }}</div>
                    <div class="image-wrap">
                        <img src="{{ section.settings.image | img_url: 'master' }}" />
                    </div>
                </div>
            </div>
            <div class="row">
                <div class="col-md-12">
                    <div class="contact-wrap lead-cap-form">
                        <form>
                                <div class="input-field">
                                    <input type="email" id="email" name="contact[email]" onkeyup="this.setAttribute('value', this.value);" value="" required="">
                                    <label for="email">Email Address</label>
                                </div>
                                <div class="input-field">
                                    <input type="tel" id="tel" name="contact[tel]" onkeyup="this.setAttribute('value', this.value);" value="" required="">
                                    <label for="tel">Phone Number</label>
                                </div>

                                <div class="content-wrap">
                                  {{ section.settings.content }}
                                </div>

                                <div class="error-form"></div>

                                <div class="input-field submit-input">
                                    <input type="submit" value="Enter to Win">
                                </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div> <!-- END PAGE WRAP -->

{% schema %}

{
    "name": "Page header",
    "settings": [
        {
            "type": "image_picker",
            "id": "image",
            "label": "Image"
        },
        {
            "type": "text",
            "id": "title",
            "label": "Title"
        },
        {
            "type": "text",
            "id": "sub-title",
            "label": "Sub title"
        },
        {
            "type": "richtext",
            "id": "content",
            "label": "Content"
        }
    ]
}

{% endschema %}
